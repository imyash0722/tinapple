#!/usr/bin/env python3
"""
tinapple-yt-to-jellyfin-nfo
Converts yt-dlp JSON metadata (.info.json) and thumbnails to Jellyfin/Kodi compliant
XML (.nfo) files and posters for instant rich streaming indexing.
"""

import sys
import os
import json
import subprocess
import xml.etree.ElementTree as ET
from xml.dom import minidom
from pathlib import Path


def format_date(raw_date):
    """Converts YYYYMMDD to YYYY-MM-DD."""
    if not raw_date or len(raw_date) != 8 or not raw_date.isdigit():
        return ""
    return f"{raw_date[:4]}-{raw_date[4:6]}-{raw_date[6:]}"


def build_nfo_xml(info):
    """Builds Kodi/Jellyfin XML structure from yt-dlp info dictionary."""
    root = ET.Element("movie")

    title = info.get("title") or "Unknown Video"
    uploader = info.get("uploader") or info.get("channel") or info.get("uploader_id") or "YouTube"
    upload_date = format_date(info.get("upload_date"))
    year = upload_date[:4] if upload_date else ""
    description = info.get("description") or ""
    video_id = info.get("id") or ""
    webpage_url = info.get("webpage_url") or f"https://www.youtube.com/watch?v={video_id}"
    duration = info.get("duration")

    # Titles
    ET.SubElement(root, "title").text = title
    ET.SubElement(root, "originaltitle").text = title
    ET.SubElement(root, "sorttitle").text = title

    # Channel / Studio
    ET.SubElement(root, "studio").text = uploader
    ET.SubElement(root, "director").text = uploader
    ET.SubElement(root, "credits").text = uploader

    # Descriptions
    ET.SubElement(root, "plot").text = description
    outline = description.split("\n")[0] if description else ""
    ET.SubElement(root, "outline").text = outline[:250]

    # Dates
    if upload_date:
        ET.SubElement(root, "premiered").text = upload_date
        ET.SubElement(root, "releasedate").text = upload_date
    if year:
        ET.SubElement(root, "year").text = year

    # Genres and Tags
    ET.SubElement(root, "genre").text = "YouTube"
    categories = info.get("categories") or []
    for cat in categories:
        if cat and cat != "YouTube":
            ET.SubElement(root, "genre").text = cat

    tags = info.get("tags") or []
    for tag in tags[:15]:
        if tag:
            ET.SubElement(root, "tag").text = tag

    # Unique ID
    if video_id:
        uniqueid = ET.SubElement(root, "uniqueid", type="youtube", default="true")
        uniqueid.text = video_id
        ET.SubElement(root, "id").text = video_id

    # Trailer
    if webpage_url:
        ET.SubElement(root, "trailer").text = webpage_url

    # Duration
    if duration:
        try:
            dur_int = int(duration)
            ET.SubElement(root, "durationinseconds").text = str(dur_int)
            ET.SubElement(root, "runtime").text = str(max(1, dur_int // 60))
        except (ValueError, TypeError):
            pass

    # Prettify XML
    rough_string = ET.tostring(root, "utf-8")
    reparsed = minidom.parseString(rough_string)
    return reparsed.toprettyxml(indent="  ", encoding="utf-8").decode("utf-8")


def convert_thumbnail_if_needed(base_no_ext):
    """Ensures a .jpg poster exists alongside the video for Jellyfin."""
    target_jpg = f"{base_no_ext}.jpg"
    poster_jpg = f"{base_no_ext}-poster.jpg"
    webp_path = f"{base_no_ext}.webp"

    # If target jpg or poster jpg already exists, we're good
    if os.path.isfile(target_jpg):
        if not os.path.isfile(poster_jpg):
            try:
                os.link(target_jpg, poster_jpg)
            except OSError:
                pass
        return target_jpg

    # Convert webp to jpg if webp exists
    if os.path.isfile(webp_path):
        try:
            subprocess.run(
                ["ffmpeg", "-y", "-i", webp_path, "-q:v", "2", target_jpg],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True
            )
            if not os.path.isfile(poster_jpg):
                try:
                    os.link(target_jpg, poster_jpg)
                except OSError:
                    pass
            return target_jpg
        except Exception:
            pass

    return None


def process_info_json(json_path):
    """Processes a single .info.json file into Jellyfin .nfo and posters."""
    json_path = Path(json_path).resolve()
    if not json_path.is_file():
        return False

    try:
        with open(json_path, "r", encoding="utf-8") as f:
            info = json.load(f)
    except Exception as e:
        print(f"Error reading {json_path}: {e}", file=sys.stderr)
        return False

    filename_str = str(json_path)
    if filename_str.endswith(".info.json"):
        base_no_ext = filename_str[:-10]
    else:
        base_no_ext = str(json_path.with_suffix(""))

    nfo_path = f"{base_no_ext}.nfo"
    xml_content = build_nfo_xml(info)

    try:
        with open(nfo_path, "w", encoding="utf-8") as f:
            f.write(xml_content)
        # 0664 permissions for shared media group
        os.chmod(nfo_path, 0o664)
    except Exception as e:
        print(f"Error writing {nfo_path}: {e}", file=sys.stderr)
        return False

    # Also handle thumbnail conversion to .jpg
    convert_thumbnail_if_needed(base_no_ext)

    # Check if parent directory needs folder.jpg
    parent_dir = json_path.parent
    folder_jpg = parent_dir / "folder.jpg"
    if not folder_jpg.exists():
        target_jpg = f"{base_no_ext}.jpg"
        if os.path.isfile(target_jpg):
            try:
                os.link(target_jpg, str(folder_jpg))
            except OSError:
                pass

    print(f"[OK] Generated Jellyfin NFO: {nfo_path}")
    return True


def scan_directory(dir_path):
    """Recursively scans directory for .info.json files."""
    count = 0
    dir_path = Path(dir_path)
    if not dir_path.is_dir():
        print(f"Directory not found: {dir_path}", file=sys.stderr)
        return 0

    for root, _, files in os.walk(dir_path):
        for file in files:
            if file.endswith(".info.json"):
                full_path = os.path.join(root, file)
                if process_info_json(full_path):
                    count += 1
    return count


def main():
    if len(sys.argv) < 2:
        target = os.environ.get("DOWNLOAD_DIR", "/srv/media/youtube")
        print(f"Scanning target: {target}")
        scanned = scan_directory(target)
        print(f"Synced {scanned} YouTube videos for Jellyfin.")
        return 0

    target = sys.argv[1]
    if os.path.isdir(target):
        scanned = scan_directory(target)
        print(f"Synced {scanned} YouTube videos in {target}.")
    elif os.path.isfile(target):
        if target.endswith(".info.json"):
            process_info_json(target)
        else:
            base_no_ext = os.path.splitext(target)[0]
            candidate_json = f"{base_no_ext}.info.json"
            if os.path.isfile(candidate_json):
                process_info_json(candidate_json)
            else:
                print(f"No .info.json found for {target}", file=sys.stderr)
    else:
        print(f"Path does not exist: {target}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
