#!/usr/bin/env bash
# ==============================================================================
# tinapple-master-install
# Pre-flight failpoint resolver and environment preparer for Tinapple OS apps
# Ensures network, clears stale pacman locks, guarantees base build tools,
# configures passwordless sudoers, and ensures paru (AUR helper) is installed.
# ==============================================================================
set -euo pipefail

log_info() { echo -e "\033[0;32m[tinapple-master-install]\033[0m [INFO] $*"; }
log_warn() { echo -e "\033[1;33m[tinapple-master-install]\033[0m [WARN] $*"; }
log_error() { echo -e "\033[0;31m[tinapple-master-install]\033[0m [ERROR] $*" >&2; }

# 1. Ensure Root Privileges
if [ "$(id -u)" -ne 0 ]; then
    log_error "This script must run with root privileges. Re-executing with sudo..."
    exec sudo "$0" "$@"
fi

# 2. Identify Primary Non-Root User
PRIMARY_USER=""
for u in pineapple tinapple; do
    if id "$u" &>/dev/null; then
        PRIMARY_USER="$u"
        break
    fi
done
if [ -z "$PRIMARY_USER" ]; then
    PRIMARY_USER=$(id -nu 1000 2>/dev/null || echo "pineapple")
fi
PRIMARY_HOME=$(getent passwd "$PRIMARY_USER" | cut -d: -f6 || echo "/home/$PRIMARY_USER")
log_info "Primary appliance user identified as: ${PRIMARY_USER} (${PRIMARY_HOME})"

# 3. Pacman Lock & Process Safety
PACMAN_LCK="/var/lib/pacman/db.lck"
if [ -f "$PACMAN_LCK" ]; then
    log_warn "Found pacman lockfile at ${PACMAN_LCK}. Checking for active pacman/paru processes..."
    if pgrep -x pacman &>/dev/null || pgrep -x paru &>/dev/null || pgrep -x makepkg &>/dev/null; then
        log_info "Active pacman/paru process is running. Waiting up to 15 seconds for completion..."
        WAITED=0
        while [ $WAITED -lt 15 ] && (pgrep -x pacman &>/dev/null || pgrep -x paru &>/dev/null || pgrep -x makepkg &>/dev/null); do
            sleep 1
            WAITED=$((WAITED+1))
        done
        if pgrep -x pacman &>/dev/null || pgrep -x paru &>/dev/null || pgrep -x makepkg &>/dev/null; then
            log_error "Pacman or Paru is still actively running. Cannot proceed simultaneously."
            exit 1
        fi
    fi
    log_warn "No active package manager process found. Safely clearing stale ${PACMAN_LCK}."
    rm -f "$PACMAN_LCK"
fi

# 4. Pacman Configuration & Database Resilience
if [ -f /etc/pacman.conf ]; then
    # Ensure DisableDownloadTimeout is set
    if ! grep -q "DisableDownloadTimeout" /etc/pacman.conf; then
        sed -i '/^\[options\]/a DisableDownloadTimeout' /etc/pacman.conf
    fi
    # Ensure [tinapple] repository does not abort on database signatures
    if grep -q "\[tinapple\]" /etc/pacman.conf; then
        sed -i '/\[tinapple\]/{n;s/.*/SigLevel = PackageOptional DatabaseNever/}' /etc/pacman.conf 2>/dev/null || true
    fi
fi

# 5. Network Connectivity Verification
log_info "Verifying network connectivity..."
NETWORK_OK=0
for endpoint in "https://archlinux.org" "https://aur.archlinux.org" "https://raw.githubusercontent.com" "https://1.1.1.1"; do
    if curl -s --connect-timeout 4 -I "$endpoint" &>/dev/null; then
        NETWORK_OK=1
        break
    fi
done
if [ "$NETWORK_OK" -eq 0 ]; then
    log_warn "Direct HTTPS ping failed. Checking captive portal / default gateway..."
    GW=$(ip route | grep '^default' | awk '{print $3}' | head -n 1 || true)
    if [ -n "$GW" ] && ping -c 1 -W 2 "$GW" &>/dev/null; then
        log_warn "Gateway reachable ($GW), but internet verification timed out. Continuing with caution."
    else
        log_error "No network gateway reachable. Please check network/Wi-Fi connection."
        exit 1
    fi
fi
log_info "Network connectivity verified."

# 6. Sudoers Configuration for Primary User
SUDOERS_FILE="/etc/sudoers.d/99-tinapple-installer"
if [ ! -f "$SUDOERS_FILE" ] || ! grep -q "$PRIMARY_USER" "$SUDOERS_FILE"; then
    log_info "Configuring passwordless sudo privileges for ${PRIMARY_USER}..."
    cat <<EOF > "$SUDOERS_FILE"
# Generated by tinapple-master-install
${PRIMARY_USER} ALL=(ALL:ALL) NOPASSWD: ALL
EOF
    chmod 0440 "$SUDOERS_FILE"
fi

# 7. Ensure Core Build Dependencies
log_info "Ensuring base development packages are installed..."
MISSING_PKGS=()
for pkg in base-devel git curl jq sudo; do
    if ! pacman -Q "$pkg" &>/dev/null; then
        MISSING_PKGS+=("$pkg")
    fi
done

if [ ${#MISSING_PKGS[@]} -gt 0 ]; then
    log_info "Installing missing base dependencies: ${MISSING_PKGS[*]}..."
    pacman -Sy --needed --noconfirm "${MISSING_PKGS[@]}"
fi

# 8. Paru Verification & Automated Installation
if command -v paru &>/dev/null; then
    PARU_BIN=$(command -v paru)
    log_info "paru is already installed at: ${PARU_BIN} ($("$PARU_BIN" -V | head -n 1))"
else
    log_warn "paru not found. Automatically compiling and installing paru-bin from AUR..."
    BUILD_DIR="/tmp/tinapple-paru-build"
    rm -rf "$BUILD_DIR"
    mkdir -p "$BUILD_DIR"
    chown -R "${PRIMARY_USER}:${PRIMARY_USER}" "$BUILD_DIR"

    log_info "Cloning paru-bin repository..."
    sudo -u "$PRIMARY_USER" git clone --depth=1 https://aur.archlinux.org/paru-bin.git "$BUILD_DIR"

    log_info "Building and installing paru-bin package..."
    (
        cd "$BUILD_DIR"
        sudo -u "$PRIMARY_USER" makepkg -si --noconfirm --needed
    )
    rm -rf "$BUILD_DIR"

    if ! command -v paru &>/dev/null; then
        log_error "Failed to install paru. Please check build logs."
        exit 1
    fi
    log_info "paru successfully installed: $(command -v paru) ($(paru -V | head -n 1))"
fi

# 9. Paru Configuration Optimization
PARU_CONF="/etc/paru.conf"
if [ -f "$PARU_CONF" ]; then
    # Ensure SkipReview is enabled for automated unattended installations
    if ! grep -q "^SkipReview" "$PARU_CONF"; then
        sed -i 's/^#SkipReview/SkipReview/' "$PARU_CONF" 2>/dev/null || echo "SkipReview" >> "$PARU_CONF"
    fi
fi

log_info "Master pre-flight checks passed successfully. System is ready for app deployment."
exit 0
