#!/usr/bin/env bash
# ==============================================================================
# tinapple-install-app
# Unified CLI installer for any Tinapple homelab application.
# Runs tinapple-master-install first, then dispatches the app installer.
# ==============================================================================
set -euo pipefail

APP_ID="${1:-}"
if [ -z "$APP_ID" ]; then
    echo "Usage: tinapple-install-app <app_id>"
    echo "Examples: tinapple-install-app jellyfin | syncyomi | radarr | filebrowser"
    exit 1
fi

# 1. Run master pre-flight check
if command -v tinapple-master-install &>/dev/null; then
    tinapple-master-install
elif [ -f "$(dirname "${BASH_SOURCE[0]}")/tinapple-master-install" ]; then
    "$(dirname "${BASH_SOURCE[0]}")/tinapple-master-install"
fi

# 2. Trigger installation via local tinapple-dash if running
if systemctl is-active --quiet tinapple-dash.service 2>/dev/null; then
    echo ">>> Triggering deployment via tinapple-dash API for ${APP_ID}..."
    RES=$(curl -s -X POST "http://127.0.0.1:8088/api/v1/apps/${APP_ID}/install" || true)
    if echo "$RES" | grep -q '"status":"installed"'; then
        echo "✅ ${APP_ID} installed successfully via appliance orchestrator."
        exit 0
    else
        echo "⚠️  Appliance API response: $RES"
        echo "Falling back to standalone installer routine..."
    fi
fi

# 3. Direct standalone fallback
PRIMARY_USER="pineapple"
if id -u tinapple &>/dev/null; then PRIMARY_USER="tinapple"; fi

case "$APP_ID" in
    suwayomi)
        if ! pacman -S --noconfirm --needed suwayomi-server-bin 2>/dev/null; then
            sudo -u "$PRIMARY_USER" paru -S --noconfirm --needed --skipreview suwayomi-server-bin
        fi
        mkdir -p /etc/systemd/system/suwayomi-server.service.d/

        # Hardware-adaptive CPU & JVM tuning (protects old 2-core/4-thread laptops while unleashing multi-core servers)
        CORES=$(nproc 2>/dev/null || echo 2)
        TOTAL_RAM_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 4000000)

        if [ "$CORES" -le 2 ]; then
            QUOTA="75%"
            NICE=10
            WEIGHT=50
        elif [ "$CORES" -le 4 ]; then
            # 2 cores / 4 threads (e.g. 1st gen mobile i5) - preserve strict thermal limits
            QUOTA="85%"
            NICE=10
            WEIGHT=50
        elif [ "$CORES" -le 6 ]; then
            QUOTA="175%"
            NICE=5
            WEIGHT=80
        else
            # 8+ logical threads (modern 4C/8T+ CPUs) - allow multi-threaded JIT and query bursts
            QUOTA="250%"
            NICE=5
            WEIGHT=100
        fi

        if [ "$TOTAL_RAM_KB" -le 4500000 ]; then
            JAVA_MEM="-Xms128m -Xmx768m -XX:+UseG1GC -Dh2.cacheSize=65536 -Dh2.objectCache=true"
        else
            JAVA_MEM="-Xms256m -Xmx1536m -XX:+UseG1GC -Dh2.cacheSize=131072 -Dh2.objectCache=true"
        fi

        cat << EOF > /etc/systemd/system/suwayomi-server.service.d/tinapple-override.conf
[Service]
# Adaptive Governor: dynamically calculated for ${CORES} CPU threads & $((TOTAL_RAM_KB / 1024))MB RAM
CPUQuota=${QUOTA}
CPUWeight=${WEIGHT}
Nice=${NICE}
Environment="JAVA_ARGS=-Dsuwayomi.tachidesk.config.server.initialOpenInBrowserEnabled=false -Dsuwayomi.tachidesk.config.server.systemTrayEnabled=false ${JAVA_MEM}"
EOF
        if [ -f /etc/suwayomi/server.conf ]; then
            sed -i "s|^JAVA_ARGS=.*|JAVA_ARGS=\"-Dsuwayomi.tachidesk.config.server.initialOpenInBrowserEnabled=false -Dsuwayomi.tachidesk.config.server.systemTrayEnabled=false ${JAVA_MEM}\"|" /etc/suwayomi/server.conf 2>/dev/null || true
        fi
        systemctl daemon-reload
        systemctl enable --now suwayomi-server.service || true
        ;;
    syncyomi)
        if [ -x /usr/local/bin/tinapple-install-syncyomi ]; then
            /usr/local/bin/tinapple-install-syncyomi
        elif [ -x "$(dirname "${BASH_SOURCE[0]}")/tinapple-install-syncyomi" ]; then
            "$(dirname "${BASH_SOURCE[0]}")/tinapple-install-syncyomi"
        fi
        ;;
    beeper)
        curl -fsSL https://github.com/beeper/bridge-manager/releases/latest/download/bbctl-linux-amd64 -o /usr/local/bin/bbctl
        chmod 755 /usr/local/bin/bbctl
        ;;
    playit)
        curl -fsSL https://github.com/playit-cloud/playit-agent/releases/latest/download/playit-linux-amd64 -o /usr/local/bin/playit
        chmod 755 /usr/local/bin/playit
        ;;
    filebrowser)
        TMP=$(mktemp -d)
        curl -fsSL https://github.com/filebrowser/filebrowser/releases/latest/download/linux-amd64-filebrowser.tar.gz -o "$TMP/fb.tar.gz"
        tar -xzf "$TMP/fb.tar.gz" -C "$TMP"
        install -Dm755 "$TMP/filebrowser" /usr/local/bin/filebrowser
        rm -rf "$TMP"
        ;;
    *)
        # Pacman / Paru fallback
        if ! pacman -S --noconfirm --needed "$APP_ID" 2>/dev/null; then
            echo "Pacman failed, installing via paru AUR helper..."
            sudo -u "$PRIMARY_USER" paru -S --noconfirm --needed --skipreview "$APP_ID" || \
            sudo -u "$PRIMARY_USER" paru -S --noconfirm --needed --skipreview "${APP_ID}-bin"
        fi
        ;;
esac

echo "✅ Deployment completed for ${APP_ID}."
