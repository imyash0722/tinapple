[Unit]
Description=Tinapple Cloudflare Tunnel Ingress (Zero-Trust / Quick Tunnel)
After=network-online.target caddy.service
Wants=network-online.target
Documentation=https://github.com/imyash0722/tinapple

[Service]
Type=simple
ExecStart=/usr/local/bin/tinapple-cloudflared-runner
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
