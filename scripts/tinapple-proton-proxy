#!/usr/bin/env python3
"""
Tinapple Proton Selective Service Proxy (SOCKS5, HTTP CONNECT & Plain HTTP)
Binds outbound traffic specifically to the 'proton' WireGuard interface (SO_BINDTODEVICE).
Allows selected services (Suwayomi, Jellyfin, etc.) to route 100% through Proton VPN
while keeping the host OS, Tailscale coordination, and web server purely on physical WAN.
"""

import sys
import os
import socket
import struct
import asyncio
import logging
import urllib.parse

LISTEN_HOST = "127.0.0.1"
LISTEN_PORT = 1088
BIND_INTERFACE = b"proton\0"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] [tinapple-proton-proxy] %(message)s"
)
logger = logging.getLogger("tinapple-proton-proxy")

def is_interface_up(ifname: str = "proton") -> bool:
    try:
        import subprocess
        res = subprocess.run(["ip", "link", "show", ifname], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return False

async def pipe_streams(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    try:
        while True:
            data = await reader.read(65536)
            if not data:
                break
            writer.write(data)
            await writer.drain()
    except Exception:
        pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass

async def create_outbound_connection(host: str, port: int) -> socket.socket:
    """Create a TCP socket bound to the proton interface if active, falling back to physical WAN."""
    loop = asyncio.get_running_loop()
    try:
        # Prioritize IPv4 as Proton WireGuard is IPv4-centric on this appliance
        addrinfos = await loop.getaddrinfo(host, port, family=socket.AF_INET, type=socket.SOCK_STREAM)
    except Exception:
        try:
            addrinfos = await loop.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except Exception as e:
            logger.warning(f"DNS resolution failed for {host}:{port}: {e}")
            raise e

    if not addrinfos:
        raise OSError(f"Could not resolve host {host}")

    last_err = None
    interface_active = is_interface_up("proton")

    for family, socktype, proto, _, sockaddr in addrinfos:
        sock = socket.socket(family, socktype, proto)
        sock.setblocking(False)

        if interface_active:
            try:
                # SO_BINDTODEVICE = 25
                sock.setsockopt(socket.SOL_SOCKET, 25, BIND_INTERFACE)
            except Exception as e:
                logger.debug(f"Could not bind to {BIND_INTERFACE.decode()}: {e}")
            try:
                # SO_MARK = 36, mark = 0x5182 (matches ip rule 5280 -> table 51820 dev proton)
                sock.setsockopt(socket.SOL_SOCKET, 36, 0x5182)
            except Exception as e:
                logger.debug(f"Could not set SO_MARK 0x5182: {e}")

        try:
            await loop.sock_connect(sock, sockaddr)
            return sock
        except Exception as e:
            sock.close()
            last_err = e

    if last_err:
        raise last_err
    raise OSError("Connection failed")

async def handle_socks5(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    # SOCKS5 Auth negotiation (client has already sent 0x05)
    nmethods_byte = await reader.read(1)
    if not nmethods_byte:
        return
    nmethods = nmethods_byte[0]
    await reader.read(nmethods)
    writer.write(b"\x05\x00")  # No auth required
    await writer.drain()

    # Request details: VER(1), CMD(1), RSV(1), ATYP(1)
    header = await reader.read(4)
    if len(header) < 4 or header[1] != 1:  # Only CONNECT (0x01) supported
        writer.write(b"\x05\x07\x00\x01\x00\x00\x00\x00\x00\x00")  # Command not supported
        await writer.drain()
        return

    atyp = header[3]
    if atyp == 1:  # IPv4 (4 bytes)
        raw_ip = await reader.read(4)
        target_host = socket.inet_ntoa(raw_ip)
    elif atyp == 3:  # Domain name
        len_byte = await reader.read(1)
        if not len_byte:
            return
        domain_len = len_byte[0]
        target_host = (await reader.read(domain_len)).decode("utf-8", errors="replace")
    elif atyp == 4:  # IPv6 (16 bytes)
        raw_ip = await reader.read(16)
        target_host = socket.inet_ntop(socket.AF_INET6, raw_ip)
    else:
        writer.write(b"\x05\x08\x00\x01\x00\x00\x00\x00\x00\x00")  # Address type not supported
        await writer.drain()
        return

    raw_port = await reader.read(2)
    if len(raw_port) < 2:
        return
    target_port = struct.unpack("!H", raw_port)[0]

    try:
        outbound_sock = await create_outbound_connection(target_host, target_port)
    except Exception as e:
        logger.warning(f"SOCKS5 connection to {target_host}:{target_port} failed: {e}")
        writer.write(b"\x05\x04\x00\x01\x00\x00\x00\x00\x00\x00")  # Host unreachable
        await writer.drain()
        return

    # SOCKS5 Success response
    writer.write(b"\x05\x00\x00\x01\x00\x00\x00\x00\x00\x00")
    await writer.drain()

    remote_reader, remote_writer = await asyncio.open_connection(sock=outbound_sock)
    await asyncio.gather(
        pipe_streams(reader, remote_writer),
        pipe_streams(remote_reader, writer)
    )

async def handle_http_connect(first_byte: bytes, reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    # Read the rest of the HTTP CONNECT request line
    line = first_byte + (await reader.readline())
    line_str = line.decode("latin1", errors="replace").strip()
    parts = line_str.split()
    if len(parts) < 2 or parts[0].upper() != "CONNECT":
        writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
        await writer.drain()
        return

    target = parts[1]
    if ":" in target:
        target_host, port_str = target.rsplit(":", 1)
        try:
            target_port = int(port_str)
        except ValueError:
            target_port = 443
    else:
        target_host = target
        target_port = 443

    # Drain headers until empty line
    while True:
        h = await reader.readline()
        if not h or h == b"\r\n" or h == b"\n":
            break

    try:
        outbound_sock = await create_outbound_connection(target_host, target_port)
    except Exception as e:
        logger.warning(f"HTTP CONNECT to {target_host}:{target_port} failed: {e}")
        writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
        await writer.drain()
        return

    writer.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
    await writer.drain()

    remote_reader, remote_writer = await asyncio.open_connection(sock=outbound_sock)
    await asyncio.gather(
        pipe_streams(reader, remote_writer),
        pipe_streams(remote_reader, writer)
    )

async def handle_plain_http(first_byte: bytes, reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    line = first_byte + (await reader.readline())
    line_str = line.decode("latin1", errors="replace").strip()
    parts = line_str.split()
    if len(parts) < 3:
        writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
        await writer.drain()
        return

    method, url, version = parts[0], parts[1], parts[2]
    parsed = urllib.parse.urlsplit(url)
    target_host = parsed.hostname
    target_port = parsed.port or (443 if parsed.scheme == "https" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query

    if not target_host:
        writer.write(b"HTTP/1.1 400 Bad Request (Missing Host)\r\n\r\n")
        await writer.drain()
        return

    # Read remaining headers
    headers = []
    while True:
        h = await reader.readline()
        if not h or h == b"\r\n" or h == b"\n":
            break
        headers.append(h)

    try:
        outbound_sock = await create_outbound_connection(target_host, target_port)
    except Exception as e:
        logger.warning(f"Plain HTTP connection to {target_host}:{target_port} failed: {e}")
        writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
        await writer.drain()
        return

    remote_reader, remote_writer = await asyncio.open_connection(sock=outbound_sock)
    
    # Send rewritten origin request
    new_request_line = f"{method} {path} {version}\r\n".encode("latin1")
    remote_writer.write(new_request_line)
    for h in headers:
        remote_writer.write(h)
    remote_writer.write(b"\r\n")
    await remote_writer.drain()

    await asyncio.gather(
        pipe_streams(reader, remote_writer),
        pipe_streams(remote_reader, writer)
    )

async def handle_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    try:
        first_byte = await reader.read(1)
        if not first_byte:
            return

        if first_byte == b"\x05":
            await handle_socks5(reader, writer)
        elif first_byte in (b"C", b"c"):  # HTTP CONNECT
            await handle_http_connect(first_byte, reader, writer)
        elif first_byte in (b"G", b"P", b"H", b"D", b"O"):  # GET, POST, HEAD, DELETE, OPTIONS
            await handle_plain_http(first_byte, reader, writer)
        else:
            writer.close()
    except Exception as e:
        pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass

async def main():
    server = await asyncio.start_server(handle_client, LISTEN_HOST, LISTEN_PORT)
    logger.info(f"Selective Proton Proxy active on {LISTEN_HOST}:{LISTEN_PORT}")
    logger.info("Protocols supported: SOCKS5, HTTP CONNECT & Plain HTTP (outbound bound to 'proton' interface)")
    async with server:
        await server.serve_forever()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
