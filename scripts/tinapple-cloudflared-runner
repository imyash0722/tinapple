#!/usr/bin/env python3
"""
Tinapple Cloudflare Tunnel Supervisor
Runs a persistent Cloudflare Tunnel for Caddy on port 80.
Supports pre-configured TUNNEL_TOKEN in /etc/tinapple/cloudflared.env
or automatically establishes a zero-config Quick Tunnel (*.trycloudflare.com).
"""
import os
import re
import sys
import signal
import subprocess
import atexit

ENV_FILE = "/etc/tinapple/cloudflared.env"
RUN_URL_FILE = "/run/tinapple-cloudflared.url"
ETC_URL_FILE = "/etc/tinapple/cloudflared.url"

def cleanup():
    try:
        if os.path.exists(RUN_URL_FILE):
            os.remove(RUN_URL_FILE)
    except Exception:
        pass

atexit.register(cleanup)

def main():
    token = None
    if os.path.exists(ENV_FILE):
        try:
            with open(ENV_FILE, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("TUNNEL_TOKEN="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            token = val
        except Exception as e:
            print(f"[tinapple-cloudflared] Error reading {ENV_FILE}: {e}", file=sys.stderr)

    if token:
        print("[tinapple-cloudflared] Starting named Cloudflare Tunnel with configured token...", flush=True)
        os.execvp("/usr/bin/cloudflared", ["cloudflared", "tunnel", "--no-autoupdate", "run", "--token", token])

    print("[tinapple-cloudflared] Starting Cloudflare Quick Tunnel for Caddy (http://127.0.0.1:80)...", flush=True)
    os.makedirs("/etc/tinapple", exist_ok=True)
    
    cmd = ["/usr/bin/cloudflared", "tunnel", "--no-autoupdate", "--url", "http://127.0.0.1:80"]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

    url_regex = re.compile(r"https://[a-zA-Z0-9-]+\.trycloudflare\.com")
    discovered_url = None

    def sig_handler(signum, frame):
        proc.terminate()
        cleanup()
        sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    try:
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            if not discovered_url:
                match = url_regex.search(line)
                if match:
                    discovered_url = match.group(0)
                    print(f"\n==================================================", flush=True)
                    print(f"[tinapple-cloudflared] Live Public URL: {discovered_url}", flush=True)
                    print(f"==================================================\n", flush=True)
                    try:
                        with open(RUN_URL_FILE, "w") as f:
                            f.write(discovered_url + "\n")
                        with open(ETC_URL_FILE, "w") as f:
                            f.write(discovered_url + "\n")
                    except Exception as e:
                        print(f"[tinapple-cloudflared] Error writing URL file: {e}", file=sys.stderr)
        proc.wait()
    except Exception as e:
        print(f"[tinapple-cloudflared] Runner exception: {e}", file=sys.stderr)
    finally:
        cleanup()

if __name__ == "__main__":
    main()
