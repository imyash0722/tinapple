#!/usr/bin/env bash
# ==============================================================================
# tinapple Resilient Tailscale Connection Watchdog & Self-Healing Auto-Restart
# Monitors Tailscale daemon and coordination health. If connectivity fails
# continuously for more than 5 minutes (300 seconds) WHILE Wi-Fi / Internet
# is active, attempts soft recovery and automatically restarts the system.
#
# NOTE: If Wi-Fi is disconnected or upstream Internet is offline ("lack of wifi"),
# the watchdog intentionally suppresses restarts to prevent bootlooping during
# nighttime router shutdowns, power cuts, or ISP outages.
# ==============================================================================
set -u

CHECK_INTERVAL=30
BOOT_GRACE_PERIOD=180
SOFT_RECOVERY_SECONDS=180
MID_RECOVERY_SECONDS=900
MAX_FAIL_SECONDS=3600
MAX_CONSECUTIVE_REBOOTS=3

STATE_DIR="/run/tinapple-tailscale-watchdog"
FAIL_FILE="${STATE_DIR}/failed_since"
RESTART_FLAG="${STATE_DIR}/restarted_flag"
REBOOT_COUNT_FILE="/var/lib/tinapple/tailscale_watchdog_reboots"

mkdir -p "${STATE_DIR}"
mkdir -p "$(dirname "${REBOOT_COUNT_FILE}")"

log() {
  local level="${1:-INFO}"
  shift
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] [tinapple-tailscale-watchdog] [${level}] $*"
}

get_uptime_seconds() {
  awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 9999
}

get_reboot_count() {
  if [[ -f "${REBOOT_COUNT_FILE}" ]]; then
    cat "${REBOOT_COUNT_FILE}" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

set_reboot_count() {
  local count="$1"
  echo "${count}" > "${REBOOT_COUNT_FILE}" 2>/dev/null || true
}

is_local_network_connected() {
  # Check if Wi-Fi or Ethernet device is in 'connected' state
  local dev_state
  dev_state=$(nmcli -t -f TYPE,STATE device 2>/dev/null | awk -F: '($1=="wifi" || $1=="ethernet") && $2=="connected"{print $1; exit}')
  [[ -n "${dev_state}" ]]
}

is_wan_reachable() {
  # Check if external internet is reachable via global DNS or connectivity check
  if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
    return 0
  fi
  if curl -s -m 2 -o /dev/null http://connectivitycheck.gstatic.com/generate_204 2>/dev/null; then
    return 0
  fi
  return 1
}

is_tailscale_healthy() {
  # 1. Check if tailscaled service is running
  if ! systemctl is-active --quiet tailscaled; then
    return 1
  fi

  # 2. Query status JSON with timeout
  local json
  if ! json=$(timeout 10 tailscale status --json 2>/dev/null); then
    return 1
  fi

  # 3. Verify backend state and coordination connectivity
  local backend_state online
  backend_state=$(echo "${json}" | jq -r '.BackendState // empty' 2>/dev/null || true)
  online=$(echo "${json}" | jq -r '.Self.Online // false' 2>/dev/null || true)

  if [[ "${backend_state}" != "Running" || "${online}" != "true" ]]; then
    return 1
  fi

  return 0
}

log "INFO" "Starting Tailscale watchdog daemon (check interval: ${CHECK_INTERVAL}s, max fail: ${MAX_FAIL_SECONDS}s)..."

while true; do
  UPTIME_S=$(get_uptime_seconds)

  # Check if still within boot grace period
  if (( UPTIME_S < BOOT_GRACE_PERIOD )); then
    log "INFO" "System booted recently (${UPTIME_S}s / ${BOOT_GRACE_PERIOD}s grace period). Waiting for network stabilization..."
    sleep "${CHECK_INTERVAL}"
    continue
  fi

  # 1. First check: Is Wi-Fi / local network connected?
  if ! is_local_network_connected; then
    if [[ -f "${FAIL_FILE}" ]]; then
      log "INFO" "[WIFI_DOWN] Wi-Fi is disconnected (lack of Wi-Fi detected). Pausing restart timer to avoid rebooting during Wi-Fi outage."
      rm -f "${FAIL_FILE}" "${RESTART_FLAG}"
    fi
    sleep "${CHECK_INTERVAL}"
    continue
  fi

  # 2. Second check: Is upstream WAN / Internet reachable?
  if ! is_wan_reachable; then
    # Self-healing probe for WireGuard VPN routing deadlock:
    if ip link show proton >/dev/null 2>&1; then
      log "WARN" "[VPN_PROBE] WAN unreachable while Proton VPN interface is up. Attempting dynamic endpoint route re-pinning..."
      EP=$(grep -m1 '^Endpoint' /etc/wireguard/proton.conf 2>/dev/null | cut -d= -f2 | cut -d: -f1 | tr -d ' ')
      GW=$(ip route show default 2>/dev/null | grep -v 'dev proton' | awk '/via/ {print $3}' | head -n1)
      DEV=$(ip route show default 2>/dev/null | grep -v 'dev proton' | awk '/dev/ {print $5}' | head -n1)
      if [[ -n "${EP}" && -n "${GW}" && -n "${DEV}" ]]; then
        ip route replace "${EP}" via "${GW}" dev "${DEV}" metric 10 2>/dev/null || true
        sleep 2
      fi
      if ! is_wan_reachable; then
        log "WARN" "[VPN_FAILSAFE] WAN still unreachable through Proton VPN. Temporarily withdrawing default dev proton metric 50 route to safeguard Tailscale and management connectivity."
        ip route del default dev proton metric 50 2>/dev/null || true
        sleep 2
      fi
    fi

    if ! is_wan_reachable; then
      if [[ -f "${FAIL_FILE}" ]]; then
        log "INFO" "[WAN_DOWN] Wi-Fi connected but upstream Internet is unreachable. Pausing restart timer to avoid rebooting during ISP outage."
        rm -f "${FAIL_FILE}" "${RESTART_FLAG}"
      fi
      sleep "${CHECK_INTERVAL}"
      continue
    else
      log "INFO" "[VPN_RECOVERED] Connectivity restored via WAN failover / endpoint re-pin."
    fi
  fi

  # 3. Third check: Wi-Fi and WAN are healthy. Check Tailscale!
  CURRENT_TIME=$(date +%s)

  if is_tailscale_healthy; then
    if [[ -f "${FAIL_FILE}" ]]; then
      log "INFO" "[RECOVERED] Tailscale connectivity restored. Watchdog timer reset."
      rm -f "${FAIL_FILE}" "${RESTART_FLAG}" "${STATE_DIR}/mid_recovery_flag"
    fi

    # Reset consecutive watchdog reboots if previously set
    REBOOT_COUNT=$(get_reboot_count)
    if [[ "${REBOOT_COUNT}" -gt 0 ]]; then
      log "INFO" "Tailscale verified healthy. Resetting consecutive watchdog reboot counter from ${REBOOT_COUNT} to 0."
      set_reboot_count 0
    fi

    # Enforce Always-On Exit Node advertisement if enabled
    ALWAYS_ON=$(jq -r '.always_on_exit_node // true' /var/lib/tinapple/tailscale_prefs.json 2>/dev/null || echo "true")
    if [[ "${ALWAYS_ON}" == "true" ]]; then
      if ! tailscale debug prefs 2>/dev/null | grep -q '"0.0.0.0/0"'; then
        log "INFO" "[ALWAYS_ON_EXIT] Re-asserting exit node advertisement (0.0.0.0/0, ::/0, 192.168.4.0/24, 192.168.1.0/24)..."
        tailscale set --advertise-exit-node --advertise-routes=192.168.4.0/24,192.168.1.0/24 >/dev/null 2>&1 || true
      fi
    fi
  else
    # Tailscale is failing EVEN THOUGH Wi-Fi and Internet are functional!
    if [[ ! -f "${FAIL_FILE}" ]]; then
      echo "${CURRENT_TIME}" > "${FAIL_FILE}"
      log "WARN" "[ALERT] Tailscale health check failed while Wi-Fi/Internet is active. Starting ${MAX_FAIL_SECONDS}s failure countdown."
    else
      FAILED_SINCE=$(cat "${FAIL_FILE}" 2>/dev/null || echo "${CURRENT_TIME}")
      ELAPSED=$(( CURRENT_TIME - FAILED_SINCE ))

      log "WARN" "Tailscale down for ${ELAPSED}s / ${MAX_FAIL_SECONDS}s (Wi-Fi/WAN active)."

      # Level 1: Soft recovery at 3 minutes
      if (( ELAPSED >= SOFT_RECOVERY_SECONDS )) && [[ ! -f "${RESTART_FLAG}" ]]; then
        log "WARN" "[ACTION] Soft recovery triggered: restarting tailscaled daemon..."
        touch "${RESTART_FLAG}"
        systemctl restart tailscaled >/dev/null 2>&1 || true
      fi

      # Level 1.5: Mid recovery at 15 minutes
      if (( ELAPSED >= MID_RECOVERY_SECONDS )) && [[ ! -f "${STATE_DIR}/mid_recovery_flag" ]]; then
        log "WARN" "[ACTION] Mid recovery triggered: cycling NetworkManager, tailscaled, and verifying campus Wi-Fi..."
        touch "${STATE_DIR}/mid_recovery_flag"
        systemctl restart NetworkManager tailscaled >/dev/null 2>&1 || true
        systemctl is-active --quiet pesu-wifi.service || systemctl start pesu-wifi.service >/dev/null 2>&1 || true
      fi

      # Level 2: Hard recovery (system reboot) at 1 hour (3600 seconds)
      if (( ELAPSED >= MAX_FAIL_SECONDS )); then
        REBOOT_COUNT=$(get_reboot_count)

        if (( REBOOT_COUNT < MAX_CONSECUTIVE_REBOOTS )); then
          NEXT_COUNT=$(( REBOOT_COUNT + 1 ))
          set_reboot_count "${NEXT_COUNT}"
          log "CRIT" "[CRITICAL] Tailscale unable to connect for ${ELAPSED}s (exceeded 1 hour timeout). Triggering automated system reboot (attempt ${NEXT_COUNT}/${MAX_CONSECUTIVE_REBOOTS})..."
          sync
          systemctl reboot
          exit 0
        else
          log "CRIT" "[CIRCUIT_BREAKER] Tailscale down for ${ELAPSED}s, but reached maximum consecutive watchdog reboots (${MAX_CONSECUTIVE_REBOOTS}). Halting further reboots to avoid boot loop."
        fi
      fi
    fi
  fi

  sleep "${CHECK_INTERVAL}"
done
