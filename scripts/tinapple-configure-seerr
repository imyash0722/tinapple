    schemas = api_request('http://127.0.0.1:8989/api/v3/downloadclient/schema', headers={'X-Api-Key': sonarr_key})
    q_schema = next((s for s in schemas if s.get('implementation') == 'QBittorrent'), None) if isinstance(schemas, list) else None

