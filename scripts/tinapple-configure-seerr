            elif f['name'] == 'port': f['value'] = 8080
            elif f['name'] == 'username': f['value'] = 'admin'
            elif f['name'] == 'password': f['value'] = 'adminadmin'
            elif f['name'] == 'tvCategory': f['value'] = 'sonarr'

        if q_client:
            api_request(f"http://127.0.0.1:8989/api/v3/downloadclient/{q_client['id']}", method='PUT', data=target, headers={'X-Api-Key': sonarr_key})
