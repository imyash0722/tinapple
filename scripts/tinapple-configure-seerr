# 8. Prowlarr: Applications, FlareSolverr Proxy, and Indexers
if prowlarr_key and radarr_key and sonarr_key:
    # 8.1 FlareSolverr Proxy Tag and Definition
    tags = api_request('http://127.0.0.1:9696/api/v1/tag', headers={'X-Api-Key': prowlarr_key})
    flaresolverr_tag_id = None
    if isinstance(tags, list):
        for t in tags:
            if t.get('label') == 'flaresolverr':
                flaresolverr_tag_id = t.get('id')
                break
    if not flaresolverr_tag_id:
        new_tag = api_request('http://127.0.0.1:9696/api/v1/tag', method='POST', data={'label': 'flaresolverr'}, headers={'X-Api-Key': prowlarr_key})
        flaresolverr_tag_id = new_tag.get('id')

    proxies = api_request('http://127.0.0.1:9696/api/v1/indexerproxy', headers={'X-Api-Key': prowlarr_key})
    has_flaresolverr = False
    if isinstance(proxies, list):
        has_flaresolverr = any(p.get('implementation') == 'FlareSolverr' for p in proxies)

    if not has_flaresolverr:
        proxy_schemas = api_request('http://127.0.0.1:9696/api/v1/indexerproxy/schema', headers={'X-Api-Key': prowlarr_key})
        if isinstance(proxy_schemas, list):
            fs_sch = next((s for s in proxy_schemas if s.get('implementation') == 'FlareSolverr'), None)
            if fs_sch:
                fs_sch['name'] = 'FlareSolverr'
                if flaresolverr_tag_id:
                    fs_sch['tags'] = [flaresolverr_tag_id]
                for f in fs_sch.get('fields', []):
                    if f['name'] == 'host': f['value'] = 'http://localhost:8191/'
                    elif f['name'] == 'requestTimeout': f['value'] = 60
                api_request('http://127.0.0.1:9696/api/v1/indexerproxy', method='POST', data=fs_sch, headers={'X-Api-Key': prowlarr_key})
                print("[✓] Prowlarr configured FlareSolverr proxy (:8191)")

    # 8.2 Applications Linking
    apps = api_request('http://127.0.0.1:9696/api/v1/applications', headers={'X-Api-Key': prowlarr_key})
    if isinstance(apps, list):
        schemas = api_request('http://127.0.0.1:9696/api/v1/applications/schema', headers={'X-Api-Key': prowlarr_key})
        if isinstance(schemas, list):
            if not any(a.get('name') == 'Radarr' for a in apps):
                rs = next((s for s in schemas if s.get('implementation') == 'Radarr'), None)
                if rs:
                    rs['enable'] = True
                    rs['name'] = 'Radarr'
                    rs['syncLevel'] = 'fullSync'
                    for f in rs['fields']:
                        if f['name'] == 'prowlarrUrl': f['value'] = 'http://localhost:9696'
                        elif f['name'] == 'baseUrl': f['value'] = 'http://localhost:7878'
                        elif f['name'] == 'apiKey': f['value'] = radarr_key
                    api_request('http://127.0.0.1:9696/api/v1/applications', method='POST', data=rs, headers={'X-Api-Key': prowlarr_key})
                    print("[✓] Prowlarr linked to Radarr (:7878)")

            if not any(a.get('name') == 'Sonarr' for a in apps):
                ss = next((s for s in schemas if s.get('implementation') == 'Sonarr'), None)
                if ss:
                    ss['enable'] = True
                    ss['name'] = 'Sonarr'
                    ss['syncLevel'] = 'fullSync'
                    for f in ss['fields']:
                        if f['name'] == 'prowlarrUrl': f['value'] = 'http://localhost:9696'
                        elif f['name'] == 'baseUrl': f['value'] = 'http://localhost:8989'
                        elif f['name'] == 'apiKey': f['value'] = sonarr_key
                        elif f['name'] == 'syncAnimeStandardFormatSearch': f['value'] = True
                    api_request('http://127.0.0.1:9696/api/v1/applications', method='POST', data=ss, headers={'X-Api-Key': prowlarr_key})
                    print("[✓] Prowlarr linked to Sonarr (:8989)")

    # 8.3 Specialized Indexers: Movies, TV, Anime, and K-Drama
    target_trackers = [
        # Movies & Popular
        'YTS',
        'The Pirate Bay',
        'Torrent Downloads',
        'Knaben',
        # Anime & Japanese Media
        'Nyaa.si',
        'Anime Tosho',
        'Tokyo Toshokan',
        'SubsPlease',
        'Shana Project'
    ]

    indexers = api_request('http://127.0.0.1:9696/api/v1/indexer', headers={'X-Api-Key': prowlarr_key})
    existing = {i.get('name'): i for i in indexers} if isinstance(indexers, list) else {}

    # Prune known broken indexers if present
    for bad in ['TorrentDownload']:
        if bad in existing:
            api_request(f"http://127.0.0.1:9696/api/v1/indexer/{existing[bad]['id']}", method='DELETE', headers={'X-Api-Key': prowlarr_key})
            print(f"[✓] Removed deprecated indexer: {bad}")

    idx_schemas = api_request('http://127.0.0.1:9696/api/v1/indexer/schema', headers={'X-Api-Key': prowlarr_key})
    if isinstance(idx_schemas, list):
        for name in target_trackers:
            if name not in existing:
                sch = next((s for s in idx_schemas if s.get('name') == name), None)
                if sch:
                    sch['enable'] = True
                    sch['appProfileId'] = 1
                    res = api_request('http://127.0.0.1:9696/api/v1/indexer', method='POST', data=sch, headers={'X-Api-Key': prowlarr_key})
                    if 'error' not in res:
                        print(f"[✓] Prowlarr added tracker: {name}")

    # Trigger Prowlarr Application Indexer Sync to propagate to Radarr & Sonarr
    api_request('http://127.0.0.1:9696/api/v1/command', method='POST', data={'name': 'ApplicationIndexerSync'}, headers={'X-Api-Key': prowlarr_key})
    print("[✓] Prowlarr synced indexers to Radarr & Sonarr")

# 9. Bazarr Configuration
bazarr_cfg = '/var/lib/bazarr/config/config.yaml'
if os.path.exists(bazarr_cfg) and radarr_key and sonarr_key:
    try:
        with open(bazarr_cfg, 'r') as f:
            b_txt = f.read()
        b_txt = re.sub(r'use_radarr:\s*false', 'use_radarr: true', b_txt)
        b_txt = re.sub(r'use_sonarr:\s*false', 'use_sonarr: true', b_txt)
        b_txt = re.sub(r'(radarr:\n\s*apikey:\s*)(\'\'|\"\")', f'\\1{radarr_key}', b_txt)
        b_txt = re.sub(r'(sonarr:\n\s*apikey:\s*)(\'\'|\"\")', f'\\1{sonarr_key}', b_txt)
        with open(bazarr_cfg, 'w') as f:
            f.write(b_txt)
        subprocess.run(['systemctl', 'restart', 'bazarr'], check=False)
        print("[✓] Bazarr subtitle automator linked to Radarr & Sonarr")
    except Exception as e:
        print(f"[!] Bazarr notice: {e}")

# 10. Jellyfin Library Configuration
if jf_token:
    jf_headers = {'Authorization': f'MediaBrowser Token="{jf_token}"'}
    folders = api_request('http://127.0.0.1:8096/Library/VirtualFolders', headers=jf_headers)
