        <string>TheTVDB</string>
        <string>TheMovieDb</string>
        <string>The Open Movie Database</string>
      </MetadataFetchers>
      <MetadataFetcherOrder>
        <string>TheTVDB</string>
        <string>TheMovieDb</string>
        <string>The Open Movie Database</string>
      </MetadataFetcherOrder>
      <ImageFetchers>
        <string>TheTVDB</string>
        <string>TheMovieDb</string>
        <string>The Open Movie Database</string>
        <string>Embedded Image Extractor</string>
        <string>Screen Grabber</string>
      </ImageFetchers>
      <ImageFetcherOrder>
        <string>TheTVDB</string>
        <string>TheMovieDb</string>
        <string>The Open Movie Database</string>
        <string>Embedded Image Extractor</string>
        <string>Screen Grabber</string>
      </ImageFetcherOrder>
      <ImageOptions />
      <SimilarItemProviders />
      <SimilarItemProviderOrder />
    </TypeOptions>
'''
    for lib in ['Shows', 'Anime', 'K-Drama', 'Movies']:
        opt_file = os.path.join(base_dir, lib, 'options.xml')
        if os.path.exists(opt_file):
            try:
                with open(opt_file, 'r', encoding='utf-8') as f:
                    c = f.read()
                c = c.replace('<EnableInternetProviders>false</EnableInternetProviders>', '<EnableInternetProviders>true</EnableInternetProviders>')
                c = c.replace('<EnableRealtimeMonitor>false</EnableRealtimeMonitor>', '<EnableRealtimeMonitor>true</EnableRealtimeMonitor>')
                if lib in ['Shows', 'Anime', 'K-Drama']:
                    if '<TypeOptions />' in c:
                        c = c.replace('<TypeOptions />', f'<TypeOptions>{tv_type_options}</TypeOptions>')
                    elif '<TypeOptions>' in c and 'TheTVDB' not in c:
                        c = c.replace('<MetadataFetchers>\\n        <string>TheMovieDb</string>', '<MetadataFetchers>\\n        <string>TheTVDB</string>\\n        <string>TheMovieDb</string>')
                        c = c.replace('<MetadataFetcherOrder>\\n        <string>TheMovieDb</string>', '<MetadataFetcherOrder>\\n        <string>TheTVDB</string>\\n        <string>TheMovieDb</string>')
                        c = c.replace('<ImageFetchers>\\n        <string>TheMovieDb</string>', '<ImageFetchers>\\n        <string>TheTVDB</string>\\n        <string>TheMovieDb</string>')
                        c = c.replace('<ImageFetcherOrder>\\n        <string>TheMovieDb</string>', '<ImageFetcherOrder>\\n        <string>TheTVDB</string>\\n        <string>TheMovieDb</string>')
                with open(opt_file, 'w', encoding='utf-8') as f:
                    f.write(c)
            except Exception:
                pass
    print("[✓] Jellyfin libraries verified (Movies, Shows, Anime, K-Drama) with Internet Providers enabled")

# 11. Jellyseerr Configuration
seerr_cfg = '/var/lib/seerr/settings.json'
if os.path.exists(seerr_cfg) and radarr_key and sonarr_key:
    try:
        with open(seerr_cfg, 'r') as f:
            cfg = json.load(f)

        has_user = False
        db_path = '/var/lib/seerr/db/db.sqlite3'
        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(db_path)
                c = conn.cursor()
                c.execute("SELECT count(*) FROM user")
                has_user = c.fetchone()[0] > 0
                conn.close()
            except Exception:
                pass
        cfg['public']['initialized'] = has_user

        # Fetch active Jellyfin libraries
        jf_libs = []
        try:
            vf = api_request('http://127.0.0.1:8096/Library/VirtualFolders', headers={'Authorization': f'MediaBrowser Token="{jf_token}"'})
            if isinstance(vf, list):
                for f in vf:
                    col_type = f.get('CollectionType')
                    if col_type in ['movies', 'tvshows']:
                        jf_libs.append({
                            'id': f.get('ItemId'),
                            'name': f.get('Name'),
                            'enabled': True,
                            'type': 'movie' if col_type == 'movies' else 'show'
                        })
        except Exception:
            pass

        if has_user:
            cfg['jellyfin'] = {
                'name': 'tinapple-server',
                'ip': '127.0.0.1',
                'port': 8096,
                'useSsl': False,
                'urlBase': '',
                'externalHostname': '',
                'jellyfinForgotPasswordUrl': '',
                'libraries': jf_libs,
                'serverId': jf_server_id,
                'apiKey': jf_token
            }
        else:
            if 'jellyfin' in cfg:
                cfg['jellyfin']['ip'] = ''

        cfg['radarr'] = [{
            'id': 0,
            'name': 'Radarr',
            'hostname': '127.0.0.1',
            'port': 7878,
            'apiKey': radarr_key,
            'useSsl': False,
            'baseUrl': '',
            'activeProfileId': 1,
            'activeProfileName': 'Any',
            'activeDirectory': '/srv/media/movies',
            'is4k': False,
            'minimumAvailability': 'released',
            'tags': [],
            'isDefault': True,
            'syncEnabled': True,
            'preventSearch': False,
            'externalUrl': ''
        }]

        cfg['sonarr'] = [{
            'id': 0,
            'name': 'Sonarr',
            'hostname': '127.0.0.1',
            'port': 8989,
            'apiKey': sonarr_key,
            'useSsl': False,
            'baseUrl': '',
            'activeProfileId': 1,
            'activeProfileName': 'Any',
            'activeDirectory': '/srv/media/shows',
            'activeLanguageProfileId': 1,
            'activeAnimeProfileId': 1,
            'activeAnimeProfileName': 'Any',
            'activeAnimeDirectory': '/srv/media/anime',
            'activeAnimeLanguageProfileId': None,
            'animeTags': [],
            'is4k': False,
            'enableSeasonFolders': True,
            'tags': [],
            'isDefault': True,
            'syncEnabled': True,
            'preventSearch': False,
            'externalUrl': ''
        }]

        with open(seerr_cfg, 'w') as f:
            json.dump(cfg, f, indent=2)

        subprocess.run(['systemctl', 'restart', 'seerr'], check=False)
        print("[✓] Jellyseerr configured & linked to Jellyfin, Radarr, and Sonarr")
    except Exception as e:
        print(f"[!] Jellyseerr notice: {e}")

# 12. Pinchflat YouTube Media Manager & Jellyfin Library Setup
try:
    os.makedirs('/srv/media/youtube', exist_ok=True)
    os.makedirs('/var/lib/pinchflat', exist_ok=True)
    subprocess.run(['systemctl', 'enable', '--now', 'pinchflat'], check=False)
    
    jellyfin_yt_dir = '/var/lib/jellyfin/root/default/YouTube'
    os.makedirs(jellyfin_yt_dir, exist_ok=True)
    yt_symlink = os.path.join(jellyfin_yt_dir, 'YouTube')
    if not os.path.exists(yt_symlink):
        try:
            os.symlink('/srv/media/youtube', yt_symlink)
        except OSError:
            pass
            
    options_xml_path = os.path.join(jellyfin_yt_dir, 'options.xml')
    if not os.path.exists(options_xml_path):
        with open(options_xml_path, 'w') as f:
            f.write('''<?xml version="1.0" encoding="utf-8"?>
<LibraryOptions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Enabled>true</Enabled>
  <EnablePhotos>false</EnablePhotos>
  <EnableRealtimeMonitor>true</EnableRealtimeMonitor>
  <EnableChapterImageExtraction>true</EnableChapterImageExtraction>
  <ExtractChapterImagesDuringLibraryScan>true</ExtractChapterImagesDuringLibraryScan>
  <PathInfos>
    <MediaPathInfo>
      <Path>/srv/media/youtube</Path>
    </MediaPathInfo>
  </PathInfos>
  <TypeOptions>
    <TypeOptions>
      <Type>Movie</Type>
      <MetadataFetchers>
        <string>Nfo</string>
      </MetadataFetchers>
      <MetadataFetcherOrder>
        <string>Nfo</string>
      </MetadataFetcherOrder>
      <ImageFetchers>
        <string>Embedded</string>
        <string>Screen Grabber</string>
      </ImageFetchers>
    </TypeOptions>
  </TypeOptions>
</LibraryOptions>
''')
    subprocess.run(['chown', '-R', 'jellyfin:jellyfin', jellyfin_yt_dir], check=False)
    print("[✓] Pinchflat YouTube library provisioned for Jellyfin (/srv/media/youtube)")
except Exception as e:
    print(f"[!] Pinchflat YouTube notice: {e}")

print("=== [SUCCESS] Full Seerr & Servarr Media Stack is 100% Configured & Ready! ===")
