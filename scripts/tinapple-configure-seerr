    # Ensure /srv/media/shows is in Shows
    if 'Shows' in existing_folders and '/srv/media/shows' not in existing_folders['Shows'].get('Locations', []):
        api_request('http://127.0.0.1:8096/Library/VirtualFolders/Paths', method='POST', data={'Name': 'Shows', 'Path': '/srv/media/shows'}, headers=jf_headers)

    # Create Anime Library if needed
    if 'Anime' not in existing_folders:
        u = 'http://127.0.0.1:8096/Library/VirtualFolders?' + urllib.parse.urlencode({'name': 'Anime', 'collectionType': 'tvshows', 'paths': '/srv/media/anime'})
        api_request(u, method='POST', headers=jf_headers)

    # Create K-Drama Library if needed
    if 'K-Drama' not in existing_folders and 'KDrama' not in existing_folders:
        u = 'http://127.0.0.1:8096/Library/VirtualFolders?' + urllib.parse.urlencode({'name': 'K-Drama', 'collectionType': 'tvshows', 'paths': '/srv/media/kdrama'})
