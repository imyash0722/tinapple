[Unit]
Description=tinapple Resilient Wi-Fi Connection Watchdog & Auto-Reconnect
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tinapple-wifi-watchdog
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
