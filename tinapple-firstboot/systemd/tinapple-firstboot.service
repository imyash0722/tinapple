[Unit]
Description=Tinapple unattended first-boot provisioning
After=network-online.target systemd-machine-id-commit.service
Wants=network-online.target
ConditionPathExists=!/etc/tinapple/.provisioned
ConditionPathExists=!/run/archiso

[Service]
Type=oneshot
ExecStart=/usr/bin/tinapple-setup
StandardInput=null
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
