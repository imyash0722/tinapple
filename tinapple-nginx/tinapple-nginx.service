[Unit]
Description=Tinapple Caddy Reverse Proxy
Documentation=https://github.com/tinapple/tinapple-arch
After=network-online.target tinapple-config-generator.service
Wants=network-online.target
Requires=tinapple-config-generator.service

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /etc/tinapple/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/tinapple/Caddyfile
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target