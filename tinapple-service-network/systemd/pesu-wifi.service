[Unit]
Description=PESU WiFi Continuous Keepalive & Auto-Login Daemon
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=simple
User=root
Environment="HOME=/root"
WorkingDirectory=/root
ExecStart=/usr/local/bin/pesu-wifi-runner
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
