# MeTube Headless YouTube Downloader Configuration for Tinapple
# Documentation: https://github.com/alexta69/metube

# Network binding
HOST=0.0.0.0
PORT=8085
URL_PREFIX=

# Storage paths
DOWNLOAD_DIR=/srv/media/youtube
AUDIO_DOWNLOAD_DIR=/srv/media/youtube-music
STATE_DIR=/var/lib/metube
TEMP_DIR=/srv/media/youtube/.tmp

# Permission mask - 002 allows group 'media' and Jellyfin to read and manage files
UMASK=002

# Custom directory organization
CUSTOM_DIRS=true
CREATE_CUSTOM_DIRS=true
DOWNLOAD_DIRS_INDEXABLE=true

# Output naming templates for clean Jellyfin indexing
OUTPUT_TEMPLATE="%(uploader,channel)s/%(title)s [%(id)s].%(ext)s"
OUTPUT_TEMPLATE_PLAYLIST="%(uploader,channel)s/%(playlist_title)s/%(playlist_index)02d - %(title)s [%(id)s].%(ext)s"
OUTPUT_TEMPLATE_CHANNEL="%(uploader,channel)s/%(upload_date>%Y-%m-%d)s - %(title)s [%(id)s].%(ext)s"

# YTDL options: subtitles, high-res thumbnails, full metadata, chapters, and MP4 compatibility
YTDL_OPTIONS='{"writesubtitles": true, "writeautomaticsub": true, "subtitleslangs": ["en.*", "-live_chat"], "writethumbnail": true, "writeinfojson": true, "embedmetadata": true, "embedthumbnail": true, "embedchapters": true, "postprocessors": [{"key": "FFmpegEmbedSubtitle"}, {"key": "FFmpegMetadata"}]}'

# Interface and queue behavior
DEFAULT_THEME=dark
MAX_CONCURRENT_DOWNLOADS=3
CLEAR_COMPLETED_AFTER=3600
DELETE_FILE_ON_TRASHCAN=false
LOGLEVEL=INFO
