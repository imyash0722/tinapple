# Maintainer: tinapple Project <https://github.com/tinapple/tinapple-arch>
pkgname=tinapple-service-downloads
pkgver=0.0.1
pkgrel=1
pkgdesc="Download clients for tinapple (qbittorrent, transmission, jdownloader2, flaresolverr, pinchflat)"
arch=(any)
url="https://github.com/tinapple/tinapple-arch"
license=(MIT)
depends=('qbittorrent-nox' 'transmission-cli' 'jdownloader2' 'flaresolverr' 'docker')
install=tinapple-service-downloads.install
source=()
sha256sums=()

package() {
  install -dm755 "$pkgdir/usr/share/tinapple-service-downloads"
  
  # Binaries
  install -Dm755 bin/tinapple-yt-to-jellyfin-nfo "$pkgdir/usr/bin/tinapple-yt-to-jellyfin-nfo"

  # Systemd services
  install -Dm644 systemd/pinchflat.service "$pkgdir/usr/lib/systemd/system/pinchflat.service"
  install -Dm644 systemd/tinapple-youtube-sync.service "$pkgdir/usr/lib/systemd/system/tinapple-youtube-sync.service"
  install -Dm644 systemd/tinapple-youtube-sync.timer "$pkgdir/usr/lib/systemd/system/tinapple-youtube-sync.timer"
}
