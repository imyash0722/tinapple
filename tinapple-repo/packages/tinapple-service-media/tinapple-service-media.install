post_install() {
  systemctl enable jellyfin.service >/dev/null 2>&1 || true
  systemctl enable sonarr.service >/dev/null 2>&1 || true
  systemctl enable radarr.service >/dev/null 2>&1 || true
  systemctl enable prowlarr.service >/dev/null 2>&1 || true
  systemctl enable bazarr.service >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable jellyfin.service >/dev/null 2>&1 || true
  systemctl disable sonarr.service >/dev/null 2>&1 || true
  systemctl disable radarr.service >/dev/null 2>&1 || true
  systemctl disable prowlarr.service >/dev/null 2>&1 || true
  systemctl disable bazarr.service >/dev/null 2>&1 || true
}