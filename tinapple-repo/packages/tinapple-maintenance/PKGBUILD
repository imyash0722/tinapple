# Maintainer: tinapple Project
pkgname=tinapple-maintenance
pkgver=0.0.1
pkgrel=2
pkgdesc="System health checks and bootable Btrfs recovery for tinapple"
arch=(any)
license=(MIT)
depends=('snapper' 'btrfs-progs' 'smartmontools' 'jq' 'python' 'util-linux' 'coreutils')
optdepends=('limine: Limine recovery entries' 'grub: GRUB recovery entries')
install=tinapple-maintenance.install
source=()
sha256sums=()
package() {
  cd "$startdir"
  for script in tinapple-health-check tinapple-update-hook tinapple-update tinapple-rollback tinapple-snapshot-boot; do
    install -Dm755 "bin/$script" "$pkgdir/usr/bin/$script"
  done
  install -Dm644 lib/init-snapper.sh "$pkgdir/usr/lib/tinapple-maintenance/init-snapper.sh"
  install -Dm644 lib/common.sh "$pkgdir/usr/lib/tinapple-maintenance/common.sh"
  install -Dm644 lib/boot-menu.py "$pkgdir/usr/lib/tinapple-maintenance/boot-menu.py"
  for hook in hooks/*.hook; do install -Dm644 "$hook" "$pkgdir/usr/share/libalpm/hooks/${hook##*/}"; done
  for unit in systemd/*; do install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/system/${unit##*/}"; done
}
