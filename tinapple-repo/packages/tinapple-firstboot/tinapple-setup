#!/usr/bin/env bash
# tinapple-setup — First-boot interactive setup wizard

set -euo pipefail

MANIFEST="/etc/tinapple/manifest.yaml"
STATE_FILE="/var/lib/tinapple/firstboot-done"

log() { echo "🔧 $*"; }
ok()  { echo "  ✓ $*"; }
warn() { echo "  ⚠ $*"; }
die() { echo "✗ $*" >&2; exit 1; }

# Check if already run
if [[ -f "$STATE_FILE" ]] && [[ "${1:-}" != "--force" ]]; then
  log "First-boot setup already completed. Re-run with --force to redo."
  exit 0
fi

# Ensure we're root
[[ $EUID -eq 0 ]] || die "Must run as root"

# Load existing manifest or create default
if [[ -f "$MANIFEST" ]]; then
  source /usr/share/tinapple-config-generator/manifest.sh 2>/dev/null || true
fi

# 1. Hardware Profile Detection
log "Detecting hardware..."
if [[ -f /usr/bin/tinapple-hw-detect ]]; then
  /usr/bin/tinapple-hw-detect
  ok "Hardware detected"
else
  warn "tinapple-hw-detect not found, skipping"
fi

# 2. Hostname
read -rp "Enter hostname [tinapple-server]: " HOSTNAME
HOSTNAME="${HOSTNAME:-tinapple-server}"
if [[ -f "$MANIFEST" ]]; then
  sed -i "s/hostname:.*/hostname: $HOSTNAME/" "$MANIFEST"
fi
hostnamectl set-hostname "$HOSTNAME" 2>/dev/null || true
ok "Hostname set to $HOSTNAME"

# 3. User Creation
read -rp "Create admin username [admin]: " ADMIN_USER
ADMIN_USER="${ADMIN_USER:-admin}"
if ! id "$ADMIN_USER" &>/dev/null; then
  read -rsp "Password for $ADMIN_USER: " ADMIN_PASS
  echo
  useradd -m -G wheel -s /bin/zsh "$ADMIN_USER" 2>/dev/null || true
  echo "$ADMIN_USER:$ADMIN_PASS" | chpasswd 2>/dev/null || true
  ok "User $ADMIN_USER created"
else
  ok "User $ADMIN_USER already exists"
fi

# 4. Tailscale Authentication
log "Configuring Tailscale..."
if command -v tailscale >/dev/null 2>&1; then
  echo "Visit the URL below to authenticate:"
  tailscale up --accept-routes --accept-dns=false --ssh || true
  ok "Tailscale configured"
else
  warn "Tailscale not installed, skipping"
fi

# 5. Service Profile Selection
echo
echo "Select service profiles to enable (space-separated, Enter for all):"
echo "  [1] base       - Core services (nginx, hw, ssh, tailscale)"
echo "  [2] media      - Jellyfin, *arr stack"
echo "  [3] downloads  - qBittorrent, Transmission, JDownloader2"
echo "  [4] backups    - Syncthing, Restic, Borg, Rclone"
echo "  [5] network    - Tailscale, WireGuard, Pi-hole, Unbound"
echo "  [6] infra      - Prometheus, Grafana, Loki, Tempo, Alertmanager"
echo "  [7] databases  - PostgreSQL, MariaDB, Redis, MongoDB, InfluxDB"
read -rp "Select profiles [1 2 3 4 5 6 7]: " PROFILES
PROFILES="${PROFILES:-1 2 3 4 5 6 7}"

# Build profiles array
PROFILE_LIST=()
for p in $PROFILES; do
  case $p in
    1) PROFILE_LIST+=("base") ;;
    2) PROFILE_LIST+=("media") ;;
    3) PROFILE_LIST+=("downloads") ;;
    4) PROFILE_LIST+=("backups") ;;
    5) PROFILE_LIST+=("network") ;;
    6) PROFILE_LIST+=("infrastructure") ;;
    7) PROFILE_LIST+=("databases") ;;
  esac
done

if [[ -f "$MANIFEST" ]]; then
  if grep -q "^profiles:" "$MANIFEST"; then
    awk -v proflist="$(printf '%s\n' "${PROFILE_LIST[@]}")" '
      BEGIN {
        n = split(proflist, arr, "\n")
      }
      /^profiles:/ {
        print "profiles:"
        for (i = 1; i <= n; i++) {
          if (arr[i] != "") print "  - " arr[i]
        }
        in_profiles = 1
        next
      }
      in_profiles && /^  -/ {
        next
      }
      {
        in_profiles = 0
        print
      }
    ' "$MANIFEST" > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
  else
    echo "profiles:" >> "$MANIFEST"
    for p in "${PROFILE_LIST[@]}"; do
      echo "  - $p" >> "$MANIFEST"
    done
  fi
fi
ok "Profiles: ${PROFILE_LIST[*]}"

# 6. Ease of Use Mode
read -rp "Enable Ease of Use Mode? (simplified UI, guided flows) [y/N]: " EASE
if [[ "${EASE,,}" == "y" ]]; then
  if [[ -f "$MANIFEST" ]]; then
    if grep -q "^ease_of_use_mode:" "$MANIFEST"; then
      sed -i 's/^ease_of_use_mode:.*/ease_of_use_mode: true/' "$MANIFEST"
    else
      echo "ease_of_use_mode: true" >> "$MANIFEST"
    fi
  fi
  ok "Ease of Use Mode enabled"
else
  if [[ -f "$MANIFEST" ]]; then
    if grep -q "^ease_of_use_mode:" "$MANIFEST"; then
      sed -i 's/^ease_of_use_mode:.*/ease_of_use_mode: false/' "$MANIFEST"
    else
      echo "ease_of_use_mode: false" >> "$MANIFEST"
    fi
  fi
  ok "Ease of Use Mode disabled"
fi

# 7. Generate Configs
log "Generating service configurations..."
if command -v tinapple-config-generator >/dev/null 2>&1 && [[ -f "$MANIFEST" ]]; then
  tinapple-config-generator generate "$MANIFEST" /etc/tinapple/generated 2>/dev/null || true
  ok "Configs generated"
else
  warn "tinapple-config-generator not found or manifest missing"
fi

# 8. Enable Selected Services
log "Enabling selected services..."
for profile in "${PROFILE_LIST[@]}"; do
  case $profile in
    base)
      systemctl enable tinapple-nginx >/dev/null 2>&1 || true
      systemctl enable tinapple-nginx.path >/dev/null 2>&1 || true
      ;;
    media)
      systemctl enable jellyfin sonarr radarr prowlarr bazarr >/dev/null 2>&1 || true
      ;;
    downloads)
      systemctl enable qbittorrent-nox@media transmission jdownloader2 flaresolverr >/dev/null 2>&1 || true
      ;;
    backups)
      systemctl enable syncthing@media restic-backup.timer borg-backup.timer >/dev/null 2>&1 || true
      ;;
    network)
      systemctl enable tailscaled wg-quick@wg0 pihole-FTL unbound >/dev/null 2>&1 || true
      ;;
    infrastructure)
      systemctl enable prometheus grafana loki tempo alertmanager >/dev/null 2>&1 || true
      ;;
    databases)
      systemctl enable postgresql mariadb redis mongod influxdb >/dev/null 2>&1 || true
      ;;
  esac
done
ok "Services enabled"

# 9. Mark Complete
mkdir -p "$(dirname "$STATE_FILE")"
echo "$(date -Iseconds)" > "$STATE_FILE"
ok "First-boot setup complete!"

echo
echo "=== Setup Complete ==="
echo "Dashboard: http://localhost:8088"
echo "Tailscale: Check 'tailscale status'"
echo "Reboot recommended to verify all services start correctly."
echo
read -rp "Reboot now? [y/N]: " REBOOT
[[ "${REBOOT,,}" == "y" ]] && reboot || true
