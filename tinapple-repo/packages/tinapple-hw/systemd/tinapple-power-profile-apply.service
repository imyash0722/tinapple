[Unit]
Description=Tinapple Power Profile Apply
Documentation=https://github.com/tinapple/tinapple-arch
After=tinapple-hw-detect.service
Requires=tinapple-hw-detect.service

[Service]
Type=oneshot
ExecStart=/usr/bin/tinapple-power-profile apply
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
