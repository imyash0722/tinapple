#!/usr/bin/env bash
# MeTube - Headless YouTube Downloader Launcher for Tinapple
set -e

# Load Tinapple environment if present
if [[ -f /etc/tinapple/metube.env ]]; then
    # shellcheck source=/dev/null
    set -a
    source /etc/tinapple/metube.env
    set +a
fi

# Detect application root directory
if [[ -n "$METUBE_HOME" && -d "$METUBE_HOME" ]]; then
    APP_DIR="$METUBE_HOME"
elif [[ -d /usr/share/metube ]]; then
    APP_DIR="/usr/share/metube"
elif [[ -d /opt/metube ]]; then
    APP_DIR="/opt/metube"
else
    # Fallback to repository / local directory
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -d "$SCRIPT_DIR/../src/app" ]]; then
        APP_DIR="$(cd "$SCRIPT_DIR/../src" && pwd)"
    else
        APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    fi
fi

# Configuration defaults
export DOWNLOAD_DIR="${DOWNLOAD_DIR:-/srv/media/youtube}"
export AUDIO_DOWNLOAD_DIR="${AUDIO_DOWNLOAD_DIR:-/srv/media/youtube-music}"
export STATE_DIR="${STATE_DIR:-/var/lib/metube}"
export TEMP_DIR="${TEMP_DIR:-${DOWNLOAD_DIR}/.tmp}"
export PORT="${PORT:-8085}"
export HOST="${HOST:-0.0.0.0}"
export UMASK="${UMASK:-002}"
export CUSTOM_DIRS="${CUSTOM_DIRS:-true}"
export CREATE_CUSTOM_DIRS="${CREATE_CUSTOM_DIRS:-true}"
export DOWNLOAD_DIRS_INDEXABLE="${DOWNLOAD_DIRS_INDEXABLE:-true}"
export OUTPUT_TEMPLATE="${OUTPUT_TEMPLATE:-%(uploader,channel)s/%(title)s [%(id)s].%(ext)s}"
export OUTPUT_TEMPLATE_PLAYLIST="${OUTPUT_TEMPLATE_PLAYLIST:-%(uploader,channel)s/%(playlist_title)s/%(playlist_index)02d - %(title)s [%(id)s].%(ext)s}"
export OUTPUT_TEMPLATE_CHANNEL="${OUTPUT_TEMPLATE_CHANNEL:-%(uploader,channel)s/%(upload_date>%Y-%m-%d)s - %(title)s [%(id)s].%(ext)s}"
export DEFAULT_THEME="${DEFAULT_THEME:-dark}"
export MAX_CONCURRENT_DOWNLOADS="${MAX_CONCURRENT_DOWNLOADS:-3}"
export BASE_DIR="${BASE_DIR:-$APP_DIR}"

# Default YTDL_OPTIONS for Jellyfin streaming compatibility
if [[ -z "$YTDL_OPTIONS" ]]; then
    export YTDL_OPTIONS='{"writesubtitles": true, "writeautomaticsub": true, "subtitleslangs": ["en.*", "-live_chat"], "writethumbnail": true, "writeinfojson": true, "embedmetadata": true, "embedthumbnail": true, "embedchapters": true}'
fi

# Apply umask so Jellyfin and media users can read/write downloads
umask "$UMASK"

# Create directories, falling back to user home if system paths are not writable
if ! mkdir -p "$DOWNLOAD_DIR" "$AUDIO_DOWNLOAD_DIR" "$STATE_DIR" "$TEMP_DIR" 2>/dev/null; then
    FALLBACK_BASE="${XDG_DATA_HOME:-$HOME/.local/share}/tinapple/media"
    export DOWNLOAD_DIR="${FALLBACK_BASE}/youtube"
    export AUDIO_DOWNLOAD_DIR="${FALLBACK_BASE}/youtube-music"
    export STATE_DIR="${FALLBACK_BASE}/.metube"
    export TEMP_DIR="${DOWNLOAD_DIR}/.tmp"
    mkdir -p "$DOWNLOAD_DIR" "$AUDIO_DOWNLOAD_DIR" "$STATE_DIR" "$TEMP_DIR"
fi

# Change into the app directory so Python module resolution works
cd "$APP_DIR/app"
export PYTHONPATH="$APP_DIR/app:${PYTHONPATH:-}"

# Find Python interpreter
if [[ -x /usr/lib/metube/venv/bin/python3 ]]; then
    PYTHON_EXEC="/usr/lib/metube/venv/bin/python3"
elif [[ -x /opt/metube/venv/bin/python3 ]]; then
    PYTHON_EXEC="/opt/metube/venv/bin/python3"
elif [[ -x /tmp/metube-test-env/bin/python3 ]]; then
    PYTHON_EXEC="/tmp/metube-test-env/bin/python3"
else
    PYTHON_EXEC="$(command -v python3)"
fi

exec "$PYTHON_EXEC" main.py
