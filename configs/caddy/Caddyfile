{
	admin "unix//run/caddy/admin.socket"
}

# Lossless compression (Zstandard & Gzip)
(compression) {
	encode zstd gzip
}

# Standard security headers
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Core appliance routing rules (shared across HTTP, Tailscale HTTPS, and LAN IP)
(tinapple_routes) {
	# 1. Dashboard & Hub Hashed Static Assets (Immutable Cache)
	handle /assets/* {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy localhost:8088
	}

	# 2. Suwayomi GraphQL API (Compressed Fast-Path)
	handle /api/graphql* {
		reverse_proxy localhost:4567
	}

	# 3. Manga Thumbnails Immutable Fast-Path (direct kernel sendfile via Dash on 8088)
	handle /api/v1/manga/*/thumbnail {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy localhost:8088
	}

	# 4. Jellyfin Home Theater
	redir /jellyfin /jellyfin/ permanent
	handle_path /jellyfin/* {
		reverse_proxy localhost:8097 {
			header_up X-Forwarded-Prefix /jellyfin
			header_down Location "http://" "https://"
		}
	}

	# 5. Suwayomi Manga Server
	redir /suwayomi /suwayomi/ permanent
	handle_path /suwayomi/* {
		reverse_proxy localhost:4567 {
			header_up X-Forwarded-Prefix /suwayomi
			header_down Location "http://" "https://"
		}
	}

	# 6. qBittorrent Web UI
	redir /qbittorrent /qbittorrent/ permanent
	handle_path /qbittorrent/* {
		reverse_proxy localhost:8080 {
			header_up X-Forwarded-Prefix /qbittorrent
			header_up Host localhost:8080
			header_down Location "http://" "https://"
		}
	}

	# 7. Media Requests (Ombi on 5000, Seerr on 5055)
	redir /ombi /ombi/ permanent
	handle /ombi/* {
		reverse_proxy localhost:5000 {
			header_up X-Forwarded-Prefix /ombi
			header_down Location "http://" "https://"
		}
	}

	redir /seerr /seerr/ permanent
	handle_path /seerr/* {
		reverse_proxy localhost:5055 {
			header_up X-Forwarded-Prefix /seerr
			header_down Location "http://" "https://"
		}
	}

	# 8. Navidrome Music Streaming
	redir /navidrome /navidrome/ permanent
	handle_path /navidrome/* {
		reverse_proxy localhost:4533 {
			header_up X-Forwarded-Prefix /navidrome
			header_down Location "http://" "https://"
		}
	}

	# 9. Syncthing Web UI
	redir /syncthing /syncthing/ permanent
	handle_path /syncthing/* {
		reverse_proxy localhost:8384 {
			header_up X-Forwarded-Prefix /syncthing
			header_up Host localhost:8384
			header_down Location "http://" "https://"
		}
	}

	# 10. Vaultwarden Password Manager
	redir /vault /vault/ permanent
	handle_path /vault/* {
		reverse_proxy localhost:8000 {
			header_up X-Forwarded-Prefix /vault
			header_down Location "http://" "https://"
		}
	}

	# 11. AdGuard Home DNS & Ad-Blocking
	redir /adguard /adguard/ permanent
	handle_path /adguard/* {
		reverse_proxy localhost:3000 {
			header_up X-Forwarded-Prefix /adguard
			header_down Location "http://" "https://"
			header_down Location "^/([^/].*)$" "/adguard/$1"
		}
	}

	# 12. Bazarr Subtitle Engine
	redir /bazarr /bazarr/ permanent
	handle_path /bazarr/* {
		reverse_proxy localhost:6767 {
			header_up X-Forwarded-Prefix /bazarr
			header_down Location "http://" "https://"
		}
	}

	# 13. Radarr Movie Automation
	redir /radarr /radarr/ permanent
	handle /radarr/* {
		reverse_proxy localhost:7878 {
			header_down Location "http://" "https://"
		}
	}

	# 14. Sonarr TV Series Automation
	redir /sonarr /sonarr/ permanent
	handle /sonarr/* {
		reverse_proxy localhost:8989 {
			header_down Location "http://" "https://"
		}
	}

	# 15. Prowlarr Indexer Manager
	redir /prowlarr /prowlarr/ permanent
	handle /prowlarr/* {
		reverse_proxy localhost:9696 {
			header_down Location "http://" "https://"
		}
	}

	# 16. Pinchflat YouTube Media Manager
	redir /pinchflat /pinchflat/ permanent
	handle_path /pinchflat/* {
		reverse_proxy localhost:8945 {
			header_down Location "http://" "https://"
		}
	}

	# 13. Matrix Client & Server Discovery
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
		respond `{"m.homeserver":{"base_url":"{scheme}://{host}"},"org.matrix.msc3575.proxy":{"url":"{scheme}://{host}"}}` 200
	}

	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.server":"tinapple.local:80"}` 200
	}

	# Element X Sliding Sync (MSC3575)
	handle /_matrix/client/unstable/org.matrix.msc3575/sync* {
		reverse_proxy localhost:8009
	}
	handle /client/unstable/org.matrix.msc3575/sync* {
		reverse_proxy localhost:8009
	}

	# Matrix Synapse Homeserver
	handle /_matrix/* {
		reverse_proxy localhost:8008
	}
	handle /_synapse/* {
		reverse_proxy localhost:8008
	}

	# Element Web Client
	redir /element /element/ permanent
	handle_path /element/* {
		root * /usr/share/webapps/element
		file_server
	}

	# Download Tinapple Root CA
	handle /tinapple-ca.crt {
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition "attachment; filename=tinapple-ca.crt"
		file_server {
			root /etc/tinapple/certs
		}
	}

	# 14. Dynamic service route extensions generated by tinapple-config-generator
	import /etc/caddy/conf.d/*.caddy

	# 15. Default Hub & Dash fallback
	handle {
		reverse_proxy localhost:8088
	}
}

# ----------------------------------------------------------------------
# 1. Standard HTTP Ingress & MagicDNS Automatic HTTPS Redirection (Port 80)
# ----------------------------------------------------------------------
http:// {
	# All Tailscale MagicDNS hostnames, FQDNs, and Tailscale 100.x IPs automatically upgrade to secure HTTPS
	@magicdns {
		header_regexp host Host (?i)^(pineapple-server(\.taildb42a2\.ts\.net)?|tinapple-server(\.tail3dee69\.ts\.net)?|.*\.ts\.net|100\.\d+\.\d+\.\d+)(:\d+)?$
	}
	redir @magicdns https://pineapple-server.taildb42a2.ts.net{uri} permanent

	import compression
	import security_headers
	import tinapple_routes
}

# ----------------------------------------------------------------------
# 3. Tailscale Automated Let's Encrypt HTTPS (Port 443)
# ----------------------------------------------------------------------
pineapple-server.taildb42a2.ts.net {
	import compression
	import security_headers
	tls /etc/caddy/certs/pineapple-server.crt /etc/caddy/certs/pineapple-server.key
	import tinapple_routes
}

# ----------------------------------------------------------------------
# 3. Jellyfin Emby Compatibility & Tsukimi Fix Bridge (Ports 8096 & 8095)
# ----------------------------------------------------------------------
http://:8096, http://:8095 {
	# Tsukimi DeleteInfo mock - resolves 404 Not Found error when deleting items in Tsukimi
	@delete_info path_regexp delete_info (?i)/(?:emby/)?Items/[^/]+/DeleteInfo$
	handle @delete_info {
		header Content-Type application/json
		respond `{"Paths":[]}` 200
	}

	# Emby token mapping for legacy clients (Ombi, etc.)
	@has_emby_token header X-Emby-Token *
	handle @has_emby_token {
		reverse_proxy localhost:8097 {
			header_up Authorization "MediaBrowser Token=\"{http.request.header.X-Emby-Token}\""
		}
	}
	@has_mb_token header X-MediaBrowser-Token *
	handle @has_mb_token {
		reverse_proxy localhost:8097 {
			header_up Authorization "MediaBrowser Token=\"{http.request.header.X-MediaBrowser-Token}\""
		}
	}
	@has_query_key query api_key=*
	handle @has_query_key {
		reverse_proxy localhost:8097 {
			header_up Authorization "MediaBrowser Token=\"{http.request.uri.query.api_key}\""
		}
	}
	@has_query_key_cap query ApiKey=*
	handle @has_query_key_cap {
		reverse_proxy localhost:8097 {
			header_up Authorization "MediaBrowser Token=\"{http.request.uri.query.ApiKey}\""
		}
	}

	# Strip legacy /emby/ prefix from Tsukimi/Emby clients
	handle_path /emby/* {
		reverse_proxy localhost:8097
	}

	# Native Jellyfin pass-through
	handle {
		reverse_proxy localhost:8097
	}
}
