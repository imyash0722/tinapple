{
	admin "unix//run/caddy/admin.socket"
}

(matrix_routes) {
	# Enable Lossless Compression (Zstandard and Gzip)
	encode zstd gzip

	# Matrix Client Discovery
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
		respond "{\"m.homeserver\":{\"base_url\":\"{scheme}://{host}\"},\"org.matrix.msc3575.proxy\":{\"url\":\"{scheme}://{host}\"}}" 200
	}

	# Matrix Server Discovery
	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond "{\"m.server\":\"tinapple.local:80\"}" 200
	}

	# Element X Sliding Sync (MSC3575)
	handle /_matrix/client/unstable/org.matrix.msc3575/sync* {
		reverse_proxy localhost:8009
	}

	handle /client/unstable/org.matrix.msc3575/sync* {
		reverse_proxy localhost:8009
	}

	# Matrix Synapse Homeserver
	handle /_matrix/* {
		reverse_proxy localhost:8008
	}

	handle /_synapse/* {
		reverse_proxy localhost:8008
	}

	# Element Web Client
	redir /element /element/ permanent
	handle_path /element/* {
		root * /usr/share/webapps/element
		file_server
	}

	# Suwayomi GraphQL API (Compressed Fast-Path)
	handle /api/graphql* {
		reverse_proxy localhost:4567
	}

	# Manga Thumbnails Immutable Fast-Path (direct kernel sendfile via Dash on 8088)
	handle /api/v1/manga/*/thumbnail* {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy localhost:8088
	}

	# Suwayomi Manga REST API Fallback
	handle /api/v1/manga* {
		reverse_proxy localhost:4567
	}

	# Jellyfin Home Theater Reverse Proxy
	handle /jellyfin* {
		reverse_proxy localhost:8096
	}

	# Dashboard & Hub Hashed Static Assets (Immutable Cache)
	handle /assets/* {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy localhost:8088
	}

	# Download Tinapple Root CA
	handle /tinapple-ca.crt {
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition "attachment; filename=tinapple-ca.crt"
		file_server {
			root /etc/tinapple/certs
		}
	}

	# Default Hub & Dash fallback
	handle {
		reverse_proxy localhost:8088
	}
}

# Tailscale HTTPS domain (Automatic Let's Encrypt Certificate)
tinapple-server.tail3dee69.ts.net {
	tls {
		get_certificate tailscale
	}
	import matrix_routes
}

# Vaultwarden Tailscale HTTPS endpoint
tinapple-server.tail3dee69.ts.net:8000 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy localhost:8001
}

# Plain HTTP for Tailscale IP and LAN IP (no SSL warning, direct fast access)
http://100.67.207.60, http://192.168.1.17, http://192.168.1.103, http://localhost, http://tinapple-server {
	import matrix_routes
}

http://100.67.207.60:8000, http://192.168.1.17:8000, http://192.168.1.103:8000, http://localhost:8000 {
	reverse_proxy localhost:8001
}

# Persistent 10-Year TLS for direct IP and LAN HTTPS access
https://100.67.207.60, https://192.168.1.17, https://192.168.1.103, https://localhost, https://tinapple-server {
	tls /etc/tinapple/certs/tinapple-fullchain.crt /etc/tinapple/certs/tinapple-server.key
	import matrix_routes
}


# Jellyfin Emby/Legacy Client Compatibility Bridge (for Ombi and legacy clients)
http://:8095 {
	@has_emby_token header X-Emby-Token *
	handle @has_emby_token {
		reverse_proxy localhost:8096 {
			header_up Authorization "MediaBrowser Token=\"{http.request.header.X-Emby-Token}\""
		}
	}
	@has_mb_token header X-MediaBrowser-Token *
	handle @has_mb_token {
		reverse_proxy localhost:8096 {
			header_up Authorization "MediaBrowser Token=\"{http.request.header.X-MediaBrowser-Token}\""
		}
	}
	@has_query_key query api_key=*
	handle @has_query_key {
		reverse_proxy localhost:8096 {
			header_up Authorization "MediaBrowser Token=\"{http.request.uri.query.api_key}\""
		}
	}
	@has_query_key_cap query ApiKey=*
	handle @has_query_key_cap {
		reverse_proxy localhost:8096 {
			header_up Authorization "MediaBrowser Token=\"{http.request.uri.query.ApiKey}\""
		}
	}
	handle {
		reverse_proxy localhost:8096
	}
}

# Ombi compatibility bridge for the existing Tailscale guest allow-rule.
http://:5055 {
	reverse_proxy localhost:5000
}
