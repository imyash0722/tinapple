#!/usr/bin/env bash
# Tinapple OS - Niri / Wayland Desktop Session Autostart
set -euo pipefail

# Set wallpaper if available
if [[ -f /usr/share/backgrounds/wallpaper.png ]] && command -v swaybg >/dev/null 2>&1; then
    pkill -x swaybg >/dev/null 2>&1 || true
    swaybg -i /usr/share/backgrounds/wallpaper.png -m fill >/dev/null 2>&1 &
fi

# Ensure Waybar is launched
if command -v omarchy-restart-waybar >/dev/null 2>&1; then
    omarchy-restart-waybar >/dev/null 2>&1 &
elif command -v waybar >/dev/null 2>&1; then
    waybar >/dev/null 2>&1 &
fi

# If booted into live ISO media and not yet installed, directly launch TUI installer in terminal
if [[ -d /run/archiso ]] && [[ ! -f /var/lib/tinapple/firstboot-done ]] && [[ ! -f /var/lib/tinapple/installed ]]; then
    LAUNCHER="/usr/local/bin/tinapple-installer-launcher"
    if [[ ! -x "$LAUNCHER" ]]; then
        LAUNCHER="/usr/local/bin/tinapple-install"
    fi

    if command -v foot >/dev/null 2>&1; then
        foot --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER" &
    elif command -v kitty >/dev/null 2>&1; then
        kitty --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER" &
    elif command -v alacritty >/dev/null 2>&1; then
        alacritty --class="tinapple-installer" --title="Tinapple OS Installer" -e "$LAUNCHER" &
    else
        xterm -title "Tinapple OS Installer" -e "$LAUNCHER" &
    fi
fi
