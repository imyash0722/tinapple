#!/usr/bin/env bash
# Tinapple OS - Welcome & Installer Launcher
set -euo pipefail

LAUNCHER="/usr/local/bin/tinapple-installer-launcher"
if [[ ! -x "$LAUNCHER" ]]; then
    LAUNCHER="/usr/local/bin/tinapple-install"
fi

# Check if browser welcome was requested or default in desktop session
if [[ "${1:-}" != "--installer" && "${1:-}" != "--tui" ]] && command -v firefox >/dev/null 2>&1; then
    for ((i=0; i<5; i++)); do
        curl -fsS http://127.0.0.1:8088/api/v1/system/info >/dev/null 2>&1 && break
        sleep 0.5
    done
    if curl -fsS http://127.0.0.1:8088/api/v1/system/info >/dev/null 2>&1; then
        exec firefox --new-window 'http://localhost:8088/?tab=welcome'
    fi
fi

if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    if command -v foot >/dev/null 2>&1; then
        exec foot --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER"
    elif command -v kitty >/dev/null 2>&1; then
        exec kitty --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER"
    elif command -v alacritty >/dev/null 2>&1; then
        exec alacritty --class="tinapple-installer" --title="Tinapple OS Installer" -e "$LAUNCHER"
    else
        exec xterm -title "Tinapple OS Installer" -e "$LAUNCHER"
    fi
else
    exec "$LAUNCHER"
fi
