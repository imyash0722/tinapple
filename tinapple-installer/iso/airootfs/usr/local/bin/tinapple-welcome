#!/usr/bin/env bash
# Tinapple OS - Installer Launcher
set -euo pipefail

LAUNCHER="/usr/local/bin/tinapple-installer-launcher"
if [[ ! -x "$LAUNCHER" ]]; then
    LAUNCHER="/usr/local/bin/tinapple-install"
fi

if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    if command -v foot >/dev/null 2>&1; then
        exec foot --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER"
    elif command -v kitty >/dev/null 2>&1; then
        exec kitty --app-id="tinapple-installer" --title="Tinapple OS Installer" "$LAUNCHER"
    elif command -v alacritty >/dev/null 2>&1; then
        exec alacritty --class="tinapple-installer" --title="Tinapple OS Installer" -e "$LAUNCHER"
    else
        exec xterm -title "Tinapple OS Installer" -e "$LAUNCHER"
    fi
else
    exec "$LAUNCHER"
fi
